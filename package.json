{
  "name": "dokohe-web",
  "version": "0.1.0",
  "description": "Public RTL frontend for the Dokohe learning academy",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgh109/dokohe.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/mgh109/dokohe/issues"
  },
  "homepage": "https://github.com/mgh109/dokohe#readme",
  "dependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "clsx": "^2.1.1",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  },
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  }
}
